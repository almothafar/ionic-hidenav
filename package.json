{
  "name": "@almothafar/ionic-hidenav",
  "version": "8.0.0",
  "description": "Auto-hiding and stretchable (collapsible) headers for Ionic + Angular. Deprecated and unmaintained \u2014 see the README for modern alternatives.",
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c tsconfig.lib.json",
    "build:prod": "rimraf dist && ng build ionic-hidenav --configuration production",
    "test": "tsx --test src/**/*.spec.ts",
    "publish:lib": "cd dist/hidenav/ && npm publish --access=public",
    "lint": "ng lint",
    "demo": "ng serve demo",
    "demo:build": "npm run build:prod && ng build demo",
    "test:e2e": "npm run demo:build && playwright test"
  },
  "peerDependencies": {
    "@angular/common": "^14.0.0 || ^15.0.0",
    "@angular/core": "^14.0.0 || ^15.0.0",
    "@ionic/angular": "^6.0.0 || ^7.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/almothafar/ionic-hidenav.git"
  },
  "keywords": [
    "ionic",
    "angular",
    "header",
    "collapsible-header",
    "hide-on-scroll",
    "autohide",
    "stretch-header",
    "deprecated"
  ],
  "author": "Al-Mothafar Al-Hasan",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/almothafar/ionic-hidenav/issues"
  },
  "homepage": "https://github.com/almothafar/ionic-hidenav#readme",
  "dependencies": {
    "@ionic-super-tabs/angular": "^7.0.8",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "21.2.24",
    "@angular-eslint/builder": "15.2.1",
    "@angular-eslint/eslint-plugin": "15.2.1",
    "@angular-eslint/eslint-plugin-template": "15.2.1",
    "@angular-eslint/schematics": "15.2.1",
    "@angular-eslint/template-parser": "15.2.1",
    "@angular/cli": "15.2.11",
    "@angular/common": "15.2.10",
    "@angular/compiler": "15.2.10",
    "@angular/compiler-cli": "22.1.6",
    "@angular/core": "15.2.10",
    "@angular/forms": "15.2.10",
    "@angular/language-service": "15.2.10",
    "@angular/platform-browser": "15.2.10",
    "@angular/platform-browser-dynamic": "15.2.10",
    "@angular/router": "15.2.10",
    "@ionic/angular": "7.8.6",
    "@playwright/test": "^1.63.0",
    "@types/jsdom": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "5.62.0",
    "@typescript-eslint/parser": "5.62.0",
    "eslint": "8.57.1",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsdoc": "46.10.1",
    "eslint-plugin-prefer-arrow": "1.2.3",
    "http-server": "^14.1.1",
    "jsdom": "^26.1.0",
    "ng-packagr": "15.2.2",
    "rimraf": "5.0.10",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "tsx": "^4.23.13",
    "typescript": "4.9.5",
    "zone.js": "0.13.3"
  }
}
